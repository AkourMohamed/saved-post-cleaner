{
  "manifest_version": 3,
  "name": "Saved Post Cleaner",
  "version": "1.0.0",
  "description": "Unsaves your saved Instagram posts, one at a time, in your own logged-in browser session. No login, no APIs.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*/saved/",
        "https://www.instagram.com/*/saved/*"
      ],
      "js": ["config.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
